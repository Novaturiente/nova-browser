+namespace {
+
+// novabrowser: force dark per site from the AUTO_DARK_WEB_CONTENT content
+// setting (its default = dark everywhere or not, exceptions per origin), for
+// http(s) pages only: the browser's own data: and chrome: pages never.
+bool ForceDarkForContents(content::WebContents* web_contents) {
+  const GURL& url = web_contents->GetLastCommittedURL();
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  auto* map = HostContentSettingsMapFactory::GetForProfile(
+      Profile::FromBrowserContext(web_contents->GetBrowserContext()));
+  return map && map->GetContentSetting(
+                    url, url, ContentSettingsType::AUTO_DARK_WEB_CONTENT) ==
+                    CONTENT_SETTING_ALLOW;
+}
