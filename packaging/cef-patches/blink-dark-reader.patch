+// novabrowser: Dark Reader's dynamic-theme colour maps (MIT,
+// github.com/darkreader/darkreader, src/inject/dynamic-theme/modify-colors.ts:
+// modifyBgHSL, modifyFgHSL, modifyBorderHSL) with its default dark theme
+// (background #181a1b, text #e8e6e3, brightness/contrast 100, no sepia or
+// grayscale, so its final colour matrix is the identity). Same maths as
+// novabrowser-webkit's WebKit patch 0001-color-filter-roles.patch.
+namespace darkreader {
+
+enum class Role : uint64_t { kBackground, kBorder, kForeground };
+
+// double, like Dark Reader's JS numbers (float flips the l < 0.2 / s < 0.24
+// thresholds)
+struct HSLA {
+  double h, s, l, a;
+};
+
+double Scale(double x,
+             double in_low,
+             double in_high,
+             double out_low,
+             double out_high) {
+  return (x - in_low) * (out_high - out_low) / (in_high - in_low) + out_low;
+}
+
+HSLA ToHSL(double r, double g, double b, double a) {
+  const double max = std::max({r, g, b});
+  const double min = std::min({r, g, b});
+  const double c = max - min;
+  const double l = (max + min) / 2;
+  if (!c)
+    return {0, 0, l, a};
+  double h = (max == r   ? std::fmod((g - b) / c, 6.0)
+              : max == g ? (b - r) / c + 2
+                         : (r - g) / c + 4) *
+             60;
+  if (h < 0)
+    h += 360;
+  return {h, c / (1 - std::abs(2 * l - 1)), l, a};
+}
+
+SkColor4f FromHSL(const HSLA& x) {
+  const double c = (1 - std::abs(2 * x.l - 1)) * x.s;
+  const double y = c * (1 - std::abs(std::fmod(x.h / 60, 2.0) - 1));
+  const double m = x.l - c / 2;
+  double r = 0, g = 0, b = 0;
+  if (x.h < 60) {
+    r = c;
+    g = y;
+  } else if (x.h < 120) {
+    r = y;
+    g = c;
+  } else if (x.h < 180) {
+    g = c;
+    b = y;
+  } else if (x.h < 240) {
+    g = y;
+    b = c;
+  } else if (x.h < 300) {
+    r = y;
+    b = c;
+  } else {
+    r = c;
+    b = y;
+  }
+  auto clamp = [](double v) {
+    return static_cast<float>(std::clamp(v, 0.0, 1.0));
+  };
+  return {clamp(r + m), clamp(g + m), clamp(b + m), static_cast<float>(x.a)};
+}
+
+const HSLA& BgPole() {
+  static const HSLA pole = ToHSL(0x18 / 255.0, 0x1a / 255.0, 0x1b / 255.0, 1);
+  return pole;
+}
+
+const HSLA& FgPole() {
+  static const HSLA pole = ToHSL(0xe8 / 255.0, 0xe6 / 255.0, 0xe3 / 255.0, 1);
+  return pole;
+}
+
+HSLA Background(const HSLA& x) {
+  constexpr double kMaxBgLightness = 0.4;
+  const HSLA& pole = BgPole();
+  const bool is_dark = x.l < 0.5;
+  const bool is_blue = x.h > 200 && x.h < 280;
+  const bool is_neutral = x.s < 0.12 || (x.l > 0.8 && is_blue);
+  if (is_dark) {
+    const double lx = Scale(x.l, 0, 0.5, 0, kMaxBgLightness);
+    if (is_neutral)
+      return {pole.h, pole.s, lx, x.a};
+    return {x.h, x.s, lx, x.a};
+  }
+  double lx = Scale(x.l, 0.5, 1, kMaxBgLightness, pole.l);
+  if (is_neutral)
+    return {pole.h, pole.s, lx, x.a};
+  double hx = x.h;
+  if (x.h > 60 && x.h < 180) {
+    hx = x.h > 120 ? Scale(x.h, 120, 180, 135, 180)
+                   : Scale(x.h, 60, 120, 60, 105);
+  }
+  // lower the lightness when the result is in the lower yellow spectrum
+  if (hx > 40 && hx < 80)
+    lx *= 0.75;
+  return {hx, x.s, lx, x.a};
+}
+
+HSLA Foreground(const HSLA& x) {
+  constexpr double kMinFgLightness = 0.55;
+  const HSLA& pole = FgPole();
+  auto blue_hue = [](double h) { return Scale(h, 205, 245, 205, 220); };
+  const bool is_light = x.l > 0.5;
+  const bool is_neutral = x.l < 0.2 || x.s < 0.24;
+  const bool is_blue = !is_neutral && x.h > 205 && x.h < 245;
+  if (is_light) {
+    const double lx = Scale(x.l, 0.5, 1, kMinFgLightness, pole.l);
+    if (is_neutral)
+      return {pole.h, pole.s, lx, x.a};
+    return {is_blue ? blue_hue(x.h) : x.h, x.s, lx, x.a};
+  }
+  if (is_neutral)
+    return {pole.h, pole.s, Scale(x.l, 0, 0.5, pole.l, kMinFgLightness), x.a};
+  if (is_blue) {
+    return {blue_hue(x.h), x.s,
+            Scale(x.l, 0, 0.5, pole.l, std::min(1.0, kMinFgLightness + 0.05)),
+            x.a};
+  }
+  return {x.h, x.s, Scale(x.l, 0, 0.5, pole.l, kMinFgLightness), x.a};
+}
+
+HSLA Border(const HSLA& x) {
+  const bool is_dark = x.l < 0.5;
+  const bool is_neutral = x.l < 0.2 || x.s < 0.24;
+  double hx = x.h, sx = x.s;
+  if (is_neutral) {
+    const HSLA& pole = is_dark ? FgPole() : BgPole();
+    hx = pole.h;
+    sx = pole.s;
+  }
+  return {hx, sx, Scale(x.l, 0, 1, 0.5, 0.2), x.a};
+}
+
+Role RoleFor(DarkModeFilter::ElementRole role) {
+  switch (role) {
+    case DarkModeFilter::ElementRole::kBackground:
+    case DarkModeFilter::ElementRole::kSelection:
+      return Role::kBackground;
+    case DarkModeFilter::ElementRole::kBorder:
+      return Role::kBorder;
+    default:  // text, list markers, SVG paint
+      return Role::kForeground;
+  }
+}
+
+SkColor4f Map(const SkColor4f& color, Role role) {
+  // from 8-bit channels, as Dark Reader parses CSS colours
+  const SkColor c = color.toSkColor();
+  const HSLA x = ToHSL(SkColorGetR(c) / 255.0, SkColorGetG(c) / 255.0,
+                       SkColorGetB(c) / 255.0, color.fA);
+  return FromHSL(role == Role::kBackground ? Background(x)
+                 : role == Role::kBorder   ? Border(x)
+                                           : Foreground(x));
+}
