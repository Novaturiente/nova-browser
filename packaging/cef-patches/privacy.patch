diff -ruN a/chrome/browser/component_updater/registration.cc b/chrome/browser/component_updater/registration.cc
--- a/chrome/browser/component_updater/registration.cc	2026-10-11 23:29:15.814522129 +0530
+++ b/chrome/browser/component_updater/registration.cc	2026-10-11 23:29:15.830561169 +0530
@@ -139,6 +139,21 @@
 void RegisterComponentsForUpdate() {
   auto* const cus = g_browser_process->component_updater();
 
+  // novabrowser: only components that keep the web working and safe; the rest
+  // (optimization hints, segmentation, privacy sandbox, safety tips, ...) are
+  // Chrome services that just phone home.
+#if BUILDFLAG(ENABLE_WIDEVINE_CDM_COMPONENT)
+  RegisterWidevineCdmComponent(cus);
+#endif
+  component_updater::RegisterCRLSetComponent(cus);
+  MaybeRegisterPKIMetadataComponent(cus);
+#if BUILDFLAG(USE_MINIKIN_HYPHENATION)
+  RegisterHyphenationComponent(cus);
+#endif
+  if (cus) {
+    return;
+  }
+
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)
   RegisterRecoveryImprovedComponent(cus, g_browser_process->local_state());
 #endif  // BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)
